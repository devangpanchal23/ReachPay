# Contact form delivery. Obtain an API key from Resend; configure a verified sender domain.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=
# Required for globally consistent production spam limits. Create an Upstash Redis REST database.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Exact public origin. Use the Vercel domain or your verified production domain at deployment.
PUBLIC_SITE_URL=http://localhost:5173
PORT=8788
APP_ORIGIN=http://localhost:5173

# Financial routes remain fail-closed until authorized integrations are implemented.
PAYIN_PROVIDER=unconfigured
POS_PROVIDER=unconfigured
PAYOUT_PROVIDER=unconfigured
BBPS_PROVIDER=unconfigured
PAYMENT_WEBHOOK_SECRET=
PAYOUT_WEBHOOK_SECRET=
BBPS_WEBHOOK_SECRET=
CRON_SECRET=

# Customer authentication (server-side only)
DATABASE_URL=
AUTH_OTP_SECRET=
AUTH_RATE_LIMIT_SECRET=

# SMTP sender for email verification codes. For personal Gmail use smtp.gmail.com:587;
# SMTP_USER is the full mailbox address. Keep SMTP_PASS only in private .env/secret storage.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=

# Mobile OTP via Twilio Verify. Obtain the Account SID/Auth Token and create a Verify Service in Twilio Console.
SMS_PROVIDER=twilio-verify
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# Paytm Wireless POS / EDC Terminal Integration
POS_PROVIDER=paytm
PAYTM_POS_MID=
PAYTM_POS_TID=
PAYTM_POS_MERCHANT_KEY=
PAYTM_POS_ENV=staging
PAYTM_POS_ENCRYPTION_SECRET=

# PhonePe Integrated EDC (official API contract: developer.phonepe.com/offline-integration/integrated-edc-solution)
# Obtain these server-side values from PhonePe after EDC API enablement. Never expose them to the browser.
PHONEPE_POS_ENV=uat
PHONEPE_POS_STORE_ID=
PHONEPE_POS_SALT_KEY=
PHONEPE_POS_SALT_INDEX=
PHONEPE_POS_PROVIDER_ID=
# Set after deploying the callback endpoint over HTTPS on port 443.
PHONEPE_POS_CALLBACK_URL=
# POS_PROVIDER=phonepe
