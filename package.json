{
  "name": "reachpay-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env scripts/dev.js",
    "start": "node --env-file-if-exists=.env server/index.js",
    "server": "node --env-file-if-exists=.env server/index.js",
    "db:check": "node --env-file-if-exists=.env scripts/check-auth-db.js",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate-auth.js",
    "db:migrate:auth": "node --env-file-if-exists=.env scripts/migrate-auth.js",
    "db:migrate:pos": "node --env-file-if-exists=.env scripts/migrate-pos.js",
    "generate:phone-lengths": "node scripts/generate-phone-lengths.js",
    "test": "node --test tests/*.test.js",
    "build": "vite build && node --env-file-if-exists=.env scripts/postbuild.js",
    "preview": "vite preview",
    "lint": "eslint ."
  },
  "dependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "libphonenumber-js": "^1.13.14",
    "lucide-react": "^1.48.0",
    "nodemailer": "^10.0.14",
    "pg": "^8.23.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0"
  }
}
